# El Fotógrafo — plantilla de variables de entorno
# Copia este archivo a .env.local y completa los valores. No subas .env.local al repositorio.

# URL base del proyecto Supabase (sin el sufijo /rest/v1/). Ej: https://xxxxx.supabase.co
SUPABASE_URL=

# Service role key de Supabase (rol: service_role). Solo se usa en el servidor, NUNCA la expongas al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Secreto para firmar la cookie de sesión (Etapa 1). Genera uno con: openssl rand -base64 32
SESSION_SECRET=

# Opcional: PIN del usuario seed (por defecto 1234). Solo se usa con `npm run seed:owner`.
# SEED_PIN=1234